# Copie para .env e ajuste. NUNCA envie o arquivo .env real para repositórios.

# development | production
KNAZH_ENV=development

# Obrigatória em produção. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Padrão: SQLite em instance/knazh.db. Exemplo alternativo: postgresql+psycopg://usuario:senha@host/banco
# DATABASE_URL=

# Domínio público quando existir (sem barra final). Usado em sitemap, robots, canonical e Open Graph.
# Deixe vazio enquanto não houver domínio definitivo.
SITE_URL=

# ---- Canais comerciais (deixe vazio até ter os dados REAIS; botões ficam ocultos) ----
# Número do WhatsApp comercial com DDD (ex.: 41999999999) — apenas dígitos, com ou sem +55
WHATSAPP_NUMBER=
# URL pública da loja no iFood (https). É apenas um link; não é integração de pedidos.
IFOOD_STORE_URL=
# Redes sociais (https). Ícones só aparecem se preenchidos.
INSTAGRAM_URL=
TIKTOK_URL=
FACEBOOK_URL=
YOUTUBE_URL=
# E-mail público exibido na página de contato (opcional)
PUBLIC_CONTACT_EMAIL=

# ---- Formulário de contato ----
# As mensagens SEMPRE ficam gravadas no banco (flask --app wsgi list-messages).
# Para também enviar por e-mail, preencha todos os campos abaixo:
CONTACT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# ---- Loja ----
MAX_QTY_PER_ITEM=20
PRODUCTS_PER_PAGE=12
# true em produção com HTTPS (padrão: true quando KNAZH_ENV=production)
# SESSION_COOKIE_SECURE=true

# ---- Administrador inicial (comando: flask --app wsgi provision-initial-admin) ----
# E-mail da conta administradora inicial (com permissão de gerenciar administradores).
INITIAL_ADMIN_EMAIL=gaabprc@gmail.com
# Senha inicial: defina SÓ no ambiente do servidor/terminal (ou deixe vazia e digite no prompt do comando).
# NUNCA a escreva no código nem a envie ao repositório; depois de criar a conta, REMOVA esta variável.
INITIAL_ADMIN_PASSWORD=
# Nome exibido da conta criada (opcional)
# INITIAL_ADMIN_NAME=Administração KNAZH

# ---- Painel administrativo / upload de fotos de produto ----
# Tamanho máximo por foto, em MiB (padrão 5). A requisição do painel aceita esse valor + 512 KiB de folga.
# UPLOAD_MAX_FILE_MB=5
# Produtos por página na lista do painel
# ADMIN_PER_PAGE=10
